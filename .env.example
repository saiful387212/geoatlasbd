# ============================================================
# GeoAtlas Bangladesh — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

APP_ENV=local
APP_DEBUG=true
APP_URL=http://geoatlas.local

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=geoatlas_bd
DB_USER=geoatlas_app
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_CHARSET=utf8mb4

# ---- Security ----
# 32+ random bytes, base64-encoded. Generate with:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

# ---- Uploads (relative to public/) ----
UPLOAD_IMAGE_MAX_BYTES=5242880
UPLOAD_PDF_MAX_BYTES=10485760